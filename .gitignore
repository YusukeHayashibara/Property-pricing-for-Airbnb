# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Data (raw/intermediate/processed are not versioned, see data/README.md) ---
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/raw/README.md
!data/interim/README.md
!data/processed/README.md
!data/external/README.md

# --- Outputs (generated artifacts) ---
outputs/figures/*
outputs/maps/*
outputs/reports/*
!outputs/figures/.gitkeep
!outputs/maps/.gitkeep
!outputs/reports/.gitkeep
!outputs/figures/README.md
!outputs/maps/README.md
!outputs/reports/README.md

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Obsidian vault (keep shared config, ignore local UI state) ---
obsidian-vault/.obsidian/workspace.json
obsidian-vault/.obsidian/workspace-mobile.json
obsidian-vault/.obsidian/cache

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
