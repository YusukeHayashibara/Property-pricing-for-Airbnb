# Copy this file to .env and fill in your own credentials.
# .env is git-ignored — never commit real keys.

# Google Places API (tourism / points of interest).
# Not obtained yet: the aggregation uses OpenStreetMap POIs as a placeholder.
GOOGLE_PLACES_API_KEY=

# TripAdvisor API / scraping credentials (if applicable)
TRIPADVISOR_API_KEY=

# Inside Airbnb — no key required, but keep the source URL configurable
INSIDE_AIRBNB_BASE_URL=https://insideairbnb.com/get-the-data/

# IPTU-SP, SSP-SP, GeoSampa and IBGE need no key. The files are downloaded by hand
# (see data/README.md) or fetched by scripts/ (IBGE population).
