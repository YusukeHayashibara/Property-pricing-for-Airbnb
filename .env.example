# Copy this file to .env and fill in your own credentials.
# .env is git-ignored — never commit real keys.

# Google Places API (tourism / points of interest)
GOOGLE_PLACES_API_KEY=

# TripAdvisor API / scraping credentials (if applicable)
TRIPADVISOR_API_KEY=

# Inside Airbnb — no key required, but keep the source URL configurable
INSIDE_AIRBNB_BASE_URL=https://insideairbnb.com/get-the-data/

# ISP-RJ (Instituto de Segurança Pública) — no key required, public data portal
ISP_RJ_BASE_URL=https://www.ispdados.rj.gov.br/

# Data.Rio / ITBI portal
DATA_RIO_BASE_URL=https://www.data.rio/

# Local paths (override defaults from src/config.py if needed)
DATA_DIR=data
OUTPUT_DIR=outputs
